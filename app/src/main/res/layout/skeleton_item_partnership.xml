<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_review_box_radius_8"
    android:paddingTop="16dp"
    android:paddingBottom="16dp"
    android:paddingStart="14dp"
    android:paddingEnd="14dp">

    <View
        android:id="@+id/skeleton_title"
        android:layout_width="150dp"
        android:layout_height="17dp"
        android:background="#E0E0E0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <View
        android:id="@+id/skeleton_tag1"
        android:layout_width="60dp"
        android:layout_height="21dp"
        android:layout_marginTop="10dp"
        android:background="#E0E0E0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/skeleton_title"/>

    <View
        android:id="@+id/skeleton_tag2"
        android:layout_width="60dp"
        android:layout_height="21dp"
        android:layout_marginTop="10dp"
        android:background="#E0E0E0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/skeleton_tag1"/>

</androidx.constraintlayout.widget.ConstraintLayout>
