<?xml version="1.0" encoding="utf-8"?>
<layout>
    <androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/assu_background"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        tools:context=".presentation.user.home.partnership_selectVerifyFragment">
        <FrameLayout
            android:id="@+id/loading_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/assu_background"
            android:visibility="gone"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="32dp">

                <ProgressBar
                    android:id="@+id/progress_bar"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:indeterminateTint="#007AFF" />

                <TextView
                    android:id="@+id/tv_loading_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="로딩 중..."
                    android:textColor="@color/assu_main"
                    android:textSize="16sp"
                    android:fontFamily="@font/pretendard_bold" />

            </LinearLayout>

        </FrameLayout>

        <FrameLayout
            android:id="@+id/fl_partnership_select_not_exist"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:background="@color/assu_background"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:id="@+id/iv_next_cross"
                    android:visibility="invisible"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    app:layout_constraintStart_toStartOf="parent"
                    android:layout_marginStart="24dp"
                    app:layout_constraintTop_toTopOf="parent"
                    android:layout_marginTop="9dp"
                    android:src="@drawable/ic_cross"/>

                <View
                    android:id="@+id/view_mg1"
                    android:layout_width="match_parent"
                    app:layout_constraintHeight_percent="0.3689"
                    android:layout_height="0dp"
                    app:layout_constraintTop_toBottomOf="@id/iv_next_cross"/>


                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    app:layout_constraintTop_toBottomOf="@id/view_mg1">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="앗, 제휴 매장이 아니에요!"
                        android:textSize="30sp"
                        android:textColor="@color/assu_font_main"
                        android:fontFamily="@font/pretendard_semibold"/>

                    <View
                        android:id="@+id/view_mg2"
                        android:layout_width="match_parent"
                        android:layout_height="10dp"/>


                    <LinearLayout
                        android:id="@+id/ll_complete_content"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <TextView
                            android:id="@+id/tv_contract_partnership_content"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="현재 소속되신 학생회와 제휴된 매장이 아닙니다."
                            android:textColor="@color/assu_font_sub"
                            android:textSize="20sp"
                            android:fontFamily="@font/pretendard_regular"/>

                    </LinearLayout>


                    <View
                        android:id="@+id/view_mg3"
                        android:layout_width="match_parent"
                        android:layout_height="20dp"/>

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/cl_partnership_select_to_home"
                        android:layout_width="114dp"
                        android:layout_height="41dp"
                        android:layout_gravity="center">

                        <ImageView
                            android:id="@+id/bg_image"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:src="@drawable/ic_home_basic_box"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent" />

                        <TextView
                            android:id="@+id/btn_check_contract"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="홈으로 돌아가기"
                            android:textSize="13sp"
                            android:fontFamily="@font/pretendard_semibold"
                            android:textColor="@color/assu_font_sub"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent" />

                    </androidx.constraintlayout.widget.ConstraintLayout>
                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </FrameLayout>


        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_partnership_select_fragment"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="invisible">
            <View
                android:id="@+id/partnership_select_h1"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                app:layout_constraintHeight_percent="0.0158"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>

            <View
                android:id="@+id/partnership_select_w1"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintWidth_percent="0.0763"
                app:layout_constraintTop_toBottomOf="@id/partnership_select_h1"
                app:layout_constraintStart_toStartOf="parent"/>

            <ImageView
                android:id="@+id/btn_back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_back"
                app:layout_constraintTop_toBottomOf="@id/partnership_select_h1"
                app:layout_constraintStart_toEndOf="@id/partnership_select_w1"/>

            <View
                android:id="@+id/partnership_select_h2"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                app:layout_constraintHeight_percent="0.0563"
                app:layout_constraintTop_toBottomOf="@id/btn_back"
                app:layout_constraintStart_toStartOf="parent"/>

            <TextView
                android:id="@+id/tv_partnership_select_market_name"
                android:fontFamily="@font/pretendard_semibold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="17sp"
                android:textColor="@color/assu_main"
                android:text="역전할머니맥주 숭실대점"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:includeFontPadding="false"
                app:layout_constraintTop_toBottomOf="@id/partnership_select_h2"/>

            <View
                android:id="@+id/partnership_select_h3"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                app:layout_constraintHeight_percent="0.0158"
                app:layout_constraintTop_toBottomOf="@id/tv_partnership_select_market_name"
                app:layout_constraintStart_toStartOf="parent"/>

            <!-- TODO : 제휴 혜택을 선택해주세요-->
            <TextView
                android:id="@+id/tv_partnership_select_guide"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="아래 혜택을 제공하고 있어요!"
                android:textSize="25sp"
                android:textColor="@color/assu_font_main"
                android:fontFamily="@font/pretendard_bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/partnership_select_h3"
                android:includeFontPadding="false"/>

            <View
                android:id="@+id/partnership_select_h4"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                app:layout_constraintHeight_percent="0.0657"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_partnership_select_guide"/>

            <View
                android:id="@+id/partnership_select_w3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                app:layout_constraintWidth_percent="0.061"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>

            <View
                android:id="@+id/partnership_select_w4"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                app:layout_constraintWidth_percent="0.061"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>


            <LinearLayout
                android:id="@+id/ll_partnership_select_buttons"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                app:layout_constraintStart_toEndOf="@id/partnership_select_w3"
                app:layout_constraintTop_toBottomOf="@id/partnership_select_h4"
                app:layout_constraintEnd_toStartOf="@id/partnership_select_w4">

                <!-- 버튼 1 -->
                <LinearLayout
                    android:id="@+id/btn_partnership_select_1"
                    android:layout_width="match_parent"
                    android:layout_height="78dp"
                    android:orientation="vertical"
                    android:background="@drawable/bg_partnership_unselected"
                    android:gravity="center"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="8dp">

                    <TextView
                        android:id="@+id/tv_partnership_1_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="IT대학 학생회"
                        android:textColor="@color/assu_font_main"
                        android:textSize="14sp"
                        android:fontFamily="@font/pretendard_semibold"
                        android:gravity="center"
                        android:textAlignment="center" />

                    <TextView
                        android:id="@+id/tv_partnership_select_1_desc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="IT대학 학생인증 시, 10% 할인"
                        android:textColor="@color/assu_font_main"
                        android:textSize="14sp"
                        android:fontFamily="@font/pretendard_regular"
                        android:gravity="center"
                        android:textAlignment="center"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <!-- 간격 -->
                <View
                    android:layout_width="0dp"
                    android:layout_height="18dp" />

                <!-- 버튼 2 -->
                <LinearLayout
                    android:id="@+id/btn_partnership_select_2"
                    android:layout_width="match_parent"
                    android:layout_height="78dp"
                    android:orientation="vertical"
                    android:background="@drawable/bg_partnership_unselected"
                    android:gravity="center"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="8dp">

                    <TextView
                        android:id="@+id/tv_partnership_select_2_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="컴퓨터학부 학생회"
                        android:textColor="@color/assu_font_main"
                        android:textSize="14sp"
                        android:fontFamily="@font/pretendard_semibold"
                        android:gravity="center"
                        android:textAlignment="center" />

                    <TextView
                        android:id="@+id/tv_partnership_select_2_desc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="4인 이상 식사시, 캔 음료 제공"
                        android:textColor="@color/assu_font_main"
                        android:textSize="14sp"
                        android:fontFamily="@font/pretendard_regular"
                        android:gravity="center"
                        android:textAlignment="center"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <!-- 간격 -->
                <View
                    android:layout_width="0dp"
                    android:layout_height="18dp" />

                <!-- 버튼 3 -->
                <LinearLayout
                    android:id="@+id/btn_partnership_select_3"
                    android:layout_width="match_parent"
                    android:layout_height="78dp"
                    android:orientation="vertical"
                    android:background="@drawable/bg_partnership_unselected"
                    android:gravity="center"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="8dp">

                    <TextView
                        android:id="@+id/tv_partnership_select_3_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="숭실대학교 총학생회"
                        android:textColor="@color/assu_font_main"
                        android:textSize="14sp"
                        android:fontFamily="@font/pretendard_semibold"
                        android:gravity="center"
                        android:textAlignment="center" />

                    <TextView
                        android:id="@+id/tv_partnership_select_3_desc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="4인 이상 식사시, 캔 음료 제공"
                        android:textColor="@color/assu_font_main"
                        android:textSize="14sp"
                        android:fontFamily="@font/pretendard_regular"
                        android:gravity="center"
                        android:textAlignment="center"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <!-- 간격 -->
                <View
                    android:layout_width="0dp"
                    android:layout_height="18dp" />

                <!-- 버튼 3 -->
                <LinearLayout
                    android:id="@+id/btn_partnership_select_4"
                    android:layout_width="match_parent"
                    android:layout_height="78dp"
                    android:orientation="vertical"
                    android:background="@drawable/bg_partnership_unselected"
                    android:gravity="center"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="8dp">

                    <TextView
                        android:id="@+id/tv_partnership_select_4_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="숭실대학교 총학생회"
                        android:textColor="@color/assu_font_main"
                        android:textSize="14sp"
                        android:fontFamily="@font/pretendard_semibold"
                        android:gravity="center"
                        android:textAlignment="center" />

                    <TextView
                        android:id="@+id/tv_partnership_select_4_desc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="4인 이상 식사시, 캔 음료 제공"
                        android:textColor="@color/assu_font_main"
                        android:textSize="14sp"
                        android:fontFamily="@font/pretendard_regular"
                        android:gravity="center"
                        android:textAlignment="center"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

            </LinearLayout>


            <View
                android:id="@+id/partnership_select_h6"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                app:layout_constraintHeight_percent="0.0606"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>

            <TextView
                android:id="@+id/btn_select_partnership_complete"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="@drawable/btn_basic_unselected"
                android:text="선택 완료"
                android:textColor="@color/assu_font_white"
                android:gravity="center"
                android:textSize="20sp"
                android:fontFamily="@font/pretendard_bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintWidth_percent="0.879"
                app:layout_constraintHeight_percent="0.0657"
                app:layout_constraintBottom_toTopOf="@id/partnership_select_h6"/>
        </androidx.constraintlayout.widget.ConstraintLayout>


    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>