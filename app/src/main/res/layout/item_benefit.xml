<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginBottom="12dp">

    <TextView
        android:id="@+id/tv_admin_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="관리자명"
        android:background="@drawable/bg_assu_sub3_radius_999"
        android:textSize="11sp"
        android:fontFamily="@font/pretendard_medium"
        android:textColor="@color/assu_main"
        android:layout_marginBottom="6dp"
        android:padding="8dp" />

    <TextView
        android:id="@+id/tv_benefit_template"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="혜택 내용"
        android:textSize="13sp"
        android:fontFamily="@font/pretendard_regular"
        android:textColor="@color/assu_font_sub"
        android:layout_marginStart="8dp"
        android:layout_marginBottom="4dp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/ll_benefit_items"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="8dp" />

</LinearLayout>
