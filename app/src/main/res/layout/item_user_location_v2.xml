<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_location_item_root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/iv_location_item_bg"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/bg_location_item"
            app:layout_constraintDimensionRatio="365:122"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <View
            android:id="@+id/view_location_item_margin_start"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintDimensionRatio="11:122"
            app:layout_constraintStart_toStartOf="@id/iv_location_item_bg"
            app:layout_constraintTop_toTopOf="@id/iv_location_item_bg"
            app:layout_constraintBottom_toBottomOf="@id/iv_location_item_bg" />

        <androidx.cardview.widget.CardView
            android:id="@+id/cv_location_item_image_container"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintWidth_percent="0.1917"
            app:cardCornerRadius="7dp"
            app:layout_constraintTop_toTopOf="@id/iv_location_item_bg"
            app:layout_constraintBottom_toBottomOf="@id/iv_location_item_bg"
            app:layout_constraintStart_toEndOf="@id/view_location_item_margin_start">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_location_item_main_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/img_partner"/>
        </androidx.cardview.widget.CardView>

        <View
            android:id="@+id/view_location_item_margin_between"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintDimensionRatio="11:122"
            app:layout_constraintTop_toTopOf="@id/iv_location_item_bg"
            app:layout_constraintBottom_toBottomOf="@id/iv_location_item_bg"
            app:layout_constraintStart_toEndOf="@id/cv_location_item_image_container" />

        <LinearLayout
            android:id="@+id/ll_location_item_content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintTop_toTopOf="@id/iv_location_item_bg"
            app:layout_constraintBottom_toBottomOf="@id/iv_location_item_bg"
            app:layout_constraintStart_toEndOf="@id/view_location_item_margin_between">

            <TextView
                android:id="@+id/tv_location_item_shop_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="역전할머니 숭실대점"
                android:textSize="17sp"
                android:fontFamily="@font/pretendard_regular"
                android:textColor="@color/assu_font_main" />

            <View
                android:layout_width="wrap_content"
                android:layout_height="10dp"/>

            <LinearLayout
                android:id="@+id/ll_partnership_description1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center">
                <TextView
                    android:id="@+id/tv_partnership_admin1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:background="@drawable/bg_assu_sub3_home_list_label"
                    android:text="총학생회"
                    android:textColor="@color/assu_main"
                    android:textSize="13sp"
                    android:fontFamily="@font/pretendard_medium"
                    android:includeFontPadding="false"
                    app:layout_constraintTop_toBottomOf="@id/tv_location_item_shop_name"
                    app:layout_constraintStart_toStartOf="@id/tv_location_item_shop_name" />

                <!-- 제휴내용 설명 -->

                <!-- 제휴기간 라벨 -->
                <TextView
                    android:id="@+id/tv_benefit_description1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="@font/pretendard_regular"
                    android:text="100,000원 이상 주문시 안주 1개 서비스"
                    android:textColor="@color/assu_font_sub"
                    android:textSize="13sp"
                    app:layout_constraintBottom_toBottomOf="@id/tv_label_benefit"
                    app:layout_constraintStart_toEndOf="@id/tv_label_benefit"
                    app:layout_constraintTop_toTopOf="@id/tv_label_benefit" />
            </LinearLayout>

            <View
                android:layout_width="wrap_content"
                android:layout_height="4dp"/>

            <LinearLayout
                android:id="@+id/ll_partnership_description2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center">
                <TextView
                    android:id="@+id/tv_partnership_admin2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:background="@drawable/bg_assu_sub3_home_list_label"
                    android:text="IT대 학생회"
                    android:textColor="@color/assu_main"
                    android:textSize="13sp"
                    android:fontFamily="@font/pretendard_medium"
                    android:includeFontPadding="false"
                    app:layout_constraintTop_toBottomOf="@id/tv_label_benefit"
                    app:layout_constraintStart_toStartOf="parent" />

                <!-- 제휴기간 날짜 -->
                <TextView
                    android:id="@+id/tv_benefit_description2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="4인 이상 식사 시, 음료 제공"
                    android:textColor="@color/assu_font_sub"
                    android:textSize="13sp"
                    android:layout_marginStart="8dp"
                    android:fontFamily="@font/pretendard_regular"
                    app:layout_constraintTop_toTopOf="@id/tv_label_period"
                    app:layout_constraintBottom_toBottomOf="@id/tv_label_period"
                    app:layout_constraintStart_toEndOf="@id/tv_label_period" />
            </LinearLayout>


        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>