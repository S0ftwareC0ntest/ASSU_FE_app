<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="89dp">

    <TextView
        android:id="@+id/tv_stamp_sort"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="19dp"
        android:text="A:SSU 앱 리뷰 작성"
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="@color/assu_font_main"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/tv_date_time"
        app:layout_constraintTop_toTopOf="parent"/>

    <TextView
        android:id="@+id/tv_date_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="24dp"
        android:text="2025-03-15 18:36"
        android:textSize="13sp"
        android:fontFamily="@font/pretendard_regular"
        android:textColor="@color/assu_font_sub"
        app:layout_constraintBaseline_toBaselineOf="@id/tv_stamp_sort"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/tv_description"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:text="A:SSU 앱 리뷰를 작성해 스탬프가 1개 적립되었어요!"
        android:textSize="12sp"
        android:fontFamily="@font/pretendard_regular"
        android:textColor="@color/assu_font_sub"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginBottom="19dp"
        app:layout_constraintStart_toEndOf="@id/tv_stamp_sort"/>


    <View
        android:id="@+id/view_location_search_result_item_line"
        android:layout_width="353dp"
        android:layout_height="1dp"
        android:background="#DCDFDF"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:visibility="visible"/>
</androidx.constraintlayout.widget.ConstraintLayout>